rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // FUNCIONES GENERALES
    // =========================================================

    function autenticado() {
      return request.auth != null;
    }

    function usuarioActual() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function esAdmin() {
      let u = usuarioActual();
      return u.rol == "ADMIN"
        && u.activo == true;
    }

    function esCliente() {
      let u = usuarioActual();
      return u.rol == "CLIENTE"
        && u.activo == true;
    }

    // Un CLIENTE puede solicitar la baja solo si su ficha está en un estado
    // que lo permite (no BAJA ni ARCHIVADO) y pertenece a su negocio.
    function esClientePuedeSolicitarBaja(clienteId, negocioId) {
      let p = /databases/$(database)/documents/clientes/$(clienteId);
      return exists(p)
        && get(p).data.negocioId == negocioId
        && get(p).data.estado != "BAJA"
        && get(p).data.estado != "ARCHIVADO";
    }

    // Un CLIENTE accede a sesiones/reservas SOLO si su estado administrativo es
    // ACTIVO (independientemente de su morosidad: moroso=true no deja de ser
    // ACTIVO). BAJA, REGISTRADO u otro estado no activo quedan excluidos.
    function clientePuedeAcceder(clienteId) {
      let c = get(
        /databases/$(database)/documents/clientes/$(clienteId)
      ).data;
      return c != null && c.estado == "ACTIVO";
    }

    // Una sola lectura de la ficha del cliente del usuario autenticado.
    // El servicio se identifica por su id (int), igual que en
    // clientes/{idCliente}.serviciosContratados.
    function servicioContratadoPorCliente(servicioId) {
      let clienteId = usuarioActual().clienteId;
      let servicios = (clienteId is int)
        ? get(
            /databases/$(database)/documents/clientes/$(clienteId)
          ).data.serviciosContratados
        : null;
      return servicioId is int
        && servicios is list
        && servicioId in servicios;
    }

    // VIA 2: un CLIENTE crea su propia ficha con el codigo maestro + DNI.
    // El Batch crea clientes/{idCliente}, indices_clientes/{negocioId}_{dni}
    // y deja usuarios/{uid} apuntando al cliente y negocio correctos.
    // La ficha debe llevar el DNI del propio perfil pendiente del usuario.
    function creacionDirectaValida(clienteId, negocioId) {
      let perfilRef = /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid);
      let clienteRef = /databases/$(database)/documents/clientes/$(clienteId);
      let usuarioRef = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return exists(perfilRef)
        && get(perfilRef).data.dni is string
        && existsAfter(clienteRef)
        && getAfter(clienteRef).data.firebaseUid == request.auth.uid
        && getAfter(clienteRef).data.negocioId == negocioId
        && getAfter(clienteRef).data.idCliente == clienteId
        && getAfter(clienteRef).data.dni == get(perfilRef).data.dni
        && getAfter(usuarioRef).data.clienteId == clienteId
        && getAfter(usuarioRef).data.negocioId == negocioId;
    }

    // VIA 1: un CLIENTE vincula su UID a una ficha existente creada por el
    // ADMIN (identificada por codigo maestro + DNI). El Batch escribe el UID
    // en clientes/{clienteId} y deja usuarios/{uid} apuntando al mismo cliente
    // y negocio. La ficha debe estar libre (firebaseUid == null), pertenecer
    // al negocio indicado y tener exactamente el DNI del perfil pendiente.
    function vinculacionDniValida(clienteId, nuevoUid, nuevoNegocioId) {
      let perfilRef = /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid);
      let clienteRef = /databases/$(database)/documents/clientes/$(clienteId);
      let usuarioRef = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return exists(perfilRef)
        && get(perfilRef).data.dni is string
        && exists(clienteRef)
        && existsAfter(clienteRef)
        && get(clienteRef).data.idCliente == clienteId
        && get(clienteRef).data.firebaseUid == null
        && get(clienteRef).data.negocioId == nuevoNegocioId
        && get(clienteRef).data.dni == get(perfilRef).data.dni
        && getAfter(clienteRef).data.firebaseUid == nuevoUid
        && getAfter(clienteRef).data.negocioId == nuevoNegocioId
        && getAfter(usuarioRef).data.clienteId == clienteId
        && getAfter(usuarioRef).data.negocioId == nuevoNegocioId;
    }

    // El documento del indice solo enlaza negocio+DNI -> ficha.
    function indiceBienFormado(indiceId) {
      return request.resource.data.keys().hasOnly(["negocioId", "dni", "clienteId"])
        && request.resource.data.negocioId is string
        && request.resource.data.dni is string
        && request.resource.data.clienteId is int
        && indiceId == request.resource.data.negocioId + "_" + request.resource.data.dni;
    }

    // El ADMIN crea el indice en el mismo Batch que crea la ficha de su negocio.
    function indiceCreadoPorAdmin(indiceId) {
      let clienteRef = /databases/$(database)/documents/clientes/$(request.resource.data.clienteId);
      return esAdmin()
        && indiceBienFormado(indiceId)
        && request.resource.data.negocioId == usuarioActual().negocioId
        && existsAfter(clienteRef)
        && getAfter(clienteRef).data.negocioId == usuarioActual().negocioId;
    }

    // El CLIENTE crea el indice en el mismo Batch que crea su propia ficha
    // (VIA 2). El DNI del indice debe ser el del perfil pendiente.
    function indiceCreadoPorCliente(indiceId) {
      let clienteRef = /databases/$(database)/documents/clientes/$(request.resource.data.clienteId);
      let perfilRef = /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid);
      return esCliente()
        && indiceBienFormado(indiceId)
        && existsAfter(clienteRef)
        && getAfter(clienteRef).data.firebaseUid == request.auth.uid
        && exists(perfilRef)
        && request.resource.data.dni == get(perfilRef).data.dni;
    }

    function sesionDelNegocio(sesionId) {
      return get(
        /databases/$(database)/documents/sesiones/$(sesionId)
      ).data.negocioId == usuarioActual().negocioId;
    }

    // El servicio existe, pertenece al negocio indicado y está activo.
    // Se usa para validar que una sesión solo pueda crear/modificar con un
    // servicio existente, del mismo negocio y activo.
    function servicioValidoParaSesion(idServicio, negocioId) {
      let servicioRef = /databases/$(database)/documents/servicios/$(idServicio);
      return exists(servicioRef)
        && get(servicioRef).data.negocioId == negocioId
        && get(servicioRef).data.activo == true;
    }

    // Una sola lectura de la sesion: negocio propio, servicio contratado por el
    // cliente autenticado, servicio activo y cliente no dado de baja.
    function sesionAccesiblePorCliente(sesionId) {
      let sesion = get(
        /databases/$(database)/documents/sesiones/$(sesionId)
      ).data;
      return sesion.negocioId == usuarioActual().negocioId
        && servicioContratadoPorCliente(sesion.idServicio)
        && get(
             /databases/$(database)/documents/servicios/$(sesion.idServicio)
           ).data.activo == true
        && clientePuedeAcceder(usuarioActual().clienteId);
    }

    // CREAR RESERVA: ya no hay validación en Rules. El CLIENTE reserva a través
    // de la Cloud Function callable `reservar` (Admin SDK), que aplica todas las
    // validaciones de negocio (estado ACTIVO, servicio contratado y activo,
    // plazas, apertura y permiteCombinarDia) en el servidor. Por eso la sesión
    // ya no necesita reglas de decremento de plazas para el CLIENTE.

    // CANCELAR RESERVA (ADMIN): la eliminación de la reserva debe ir acompañada
    // del incremento de plazasDisponibles (sin superar la capacidad).
    function reservaEliminadaValida(sesionId, negocioId) {
      let sesionRef = /databases/$(database)/documents/sesiones/$(sesionId);
      return exists(sesionRef)
        && get(sesionRef).data.negocioId == negocioId
        && getAfter(sesionRef).data.plazasDisponibles == get(sesionRef).data.plazasDisponibles + 1
        && getAfter(sesionRef).data.plazasDisponibles <= get(sesionRef).data.capacidad;
    }

    // Cascada administrativa: la reserva se borra porque su SESIÓN se elimina
    // en la MISMA operación (la plaza muere con la sesión). Solo el ADMIN puede
    // borrar reservas sin liberar plaza, y solo si la sesión desaparece con ella.
    function cascadaEliminaSesion(sesionId) {
      let sesionRef = /databases/$(database)/documents/sesiones/$(sesionId);
      return exists(sesionRef)
        && get(sesionRef).data.negocioId == usuarioActual().negocioId
        && !existsAfter(sesionRef);
    }


    // =========================================================
    // NEGOCIOS
    // =========================================================

    match /negocios/{negocioId} {
      allow get: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && resource.data.adminUid == request.auth.uid;

      allow list: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && resource.data.adminUid == request.auth.uid;

      allow create: if esAdmin()
        && usuarioActual().negocioId == null
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.codigoMaestro is string
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.negocioId == negocioId
        && getAfter(
          /databases/$(database)/documents/codigos_maestros/$(request.resource.data.codigoMaestro)
        ).data.negocioId == negocioId;

      allow update: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && resource.data.adminUid == request.auth.uid
        && request.resource.data.adminUid == request.auth.uid
        && (!request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(["codigoMaestro"])
            || (request.resource.data.codigoMaestro is string
                && getAfter(
                  /databases/$(database)/documents/codigos_maestros/$(request.resource.data.codigoMaestro)
                ).data.negocioId == negocioId));

      allow delete: if false;
    }


    // =========================================================
    // NEGOCIOS PUBLICOS
    // =========================================================

    match /negocios_publicos/{negocioId} {
      allow get, list: if autenticado();

      allow create: if esAdmin()
        && request.resource.data.keys()
            .hasOnly([
              "codigoMaestro", "nombre", "logo",
              "horarioCentro", "horarioActividades", "horarioExcepciones"
            ])
        && usuarioActual().negocioId == null
        && request.resource.data.codigoMaestro is string
        && request.resource.data.nombre is string
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.negocioId == negocioId
        && getAfter(
          /databases/$(database)/documents/codigos_maestros/$(request.resource.data.codigoMaestro)
        ).data.negocioId == negocioId;

      allow update: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "codigoMaestro", "nombre", "logo",
              "horarioCentro", "horarioActividades", "horarioExcepciones"
            ])
        && (!request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(["codigoMaestro"])
            || (request.resource.data.codigoMaestro is string
                && getAfter(
                  /databases/$(database)/documents/codigos_maestros/$(request.resource.data.codigoMaestro)
                ).data.negocioId == negocioId));

      allow delete: if false;
    }

    // =========================================================
    // CODIGOS MAESTROS (unicidad global)
    // documentId = codigo normalizado. UN codigo = UN negocio.
    // No enumerable. La reserva y los documentos negocios/negocios_publicos
    // deben quedar coherentes dentro de la misma operación (getAfter).
    // =========================================================

    match /codigos_maestros/{codigo} {
      allow get: if autenticado();

      allow list: if false;

      allow update: if false;

      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(["negocioId"])
        && request.resource.data.negocioId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/negocios/$(request.resource.data.negocioId)
        ).data.codigoMaestro == codigo
        && getAfter(
          /databases/$(database)/documents/negocios_publicos/$(request.resource.data.negocioId)
        ).data.codigoMaestro == codigo;

      allow delete: if esAdmin()
        && resource.data.keys().hasOnly(["negocioId"])
        && resource.data.negocioId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/negocios/$(resource.data.negocioId)
        ).data.codigoMaestro != codigo
        && getAfter(
          /databases/$(database)/documents/negocios_publicos/$(resource.data.negocioId)
        ).data.codigoMaestro != codigo;
    }


    // =========================================================
    // USUARIOS
    // =========================================================

    match /usuarios/{uid} {
      allow get: if autenticado()
        && request.auth.uid == uid;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.rol in ["ADMIN", "CLIENTE"]
        && request.resource.data.activo == true
        && request.resource.data.clienteId == null
        && request.resource.data.negocioId == null;

      // Un ADMIN nuevo puede crear su negocio, pero no vincularse a uno ajeno.
      allow update: if esAdmin()
        && request.auth.uid == uid
        && resource.data.negocioId == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["negocioId"])
        && request.resource.data.negocioId is string
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo
        && request.resource.data.clienteId == resource.data.clienteId
        && getAfter(
          /databases/$(database)/documents/negocios/$(request.resource.data.negocioId)
        ).data.adminUid == request.auth.uid;

      // VIA 1: vincularse a una ficha existente identificada por codigo+Dni.
      allow update: if esCliente()
        && request.auth.uid == uid
        && resource.data.clienteId == null
        && resource.data.negocioId == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["clienteId", "negocioId"])
        && request.resource.data.clienteId is int
        && request.resource.data.negocioId is string
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo
        && vinculacionDniValida(
             request.resource.data.clienteId,
             request.auth.uid,
             request.resource.data.negocioId
           );

      // VIA 2: un CLIENTE se vincula creando su propia ficha con el codigo
      // maestro; la misma operacion crea clientes/{idCliente} y el indice.
      allow update: if esCliente()
        && request.auth.uid == uid
        && resource.data.clienteId == null
        && resource.data.negocioId == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["clienteId", "negocioId"])
        && request.resource.data.clienteId is int
        && request.resource.data.negocioId is string
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo
        && creacionDirectaValida(
             request.resource.data.clienteId,
             request.resource.data.negocioId
           );

      allow delete: if false;
    }


    // =========================================================
    // CLIENTES
    // =========================================================

    match /clientes/{clienteId} {
      allow get: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      // CLIENTE ya vinculado: solo puede leer su propia ficha.
      allow get: if esCliente()
        && string(usuarioActual().clienteId) == clienteId
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.firebaseUid == request.auth.uid;

      // VIA 1: CLIENTE aun sin vincular (clienteId/negocioId null) declara en
      // perfiles_pendientes/{uid} la combinacion { dni, negocioId } que quiere
      // vincular. Solo puede leer la ficha cuyo DNI y negocioId coinciden con
      // esa declaracion y cuyo documentId corresponde a su idCliente. No puede
      // leer fichas arbitrarias, de otros negocios ni de otros DNIs.
      allow get: if esCliente()
        && usuarioActual().clienteId == null
        && usuarioActual().negocioId == null
        && exists(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           )
        && get(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           ).data.dni is string
        && get(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           ).data.negocioId is string
        && get(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           ).data.dni == resource.data.dni
        && get(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           ).data.negocioId == resource.data.negocioId
        && string(resource.data.idCliente) == clienteId;

      // VIA 2: lectura de una ficha AUN NO CREADA (resource == null) dentro de
      // la Transaction que la va a crear. Solo un CLIENTE sin vinculo con perfil
      // pendiente puede comprobar que clientes/{id} no existe; al exigir
      // resource == null no permite leer los datos de fichas existentes de otros.
      allow get: if esCliente()
        && usuarioActual().clienteId == null
        && usuarioActual().negocioId == null
        && exists(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           )
        && resource == null;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      // Alta por el ADMIN: la ficha nace sin UID y sin indice propio hasta
      // que se replica; el indice se crea en el mismo Batch (Vía 1).
      // observaciones NO vive aqui: esta en clientes_privados/{idCliente}.
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly([
           "idCliente",
           "negocioId",
           "firebaseUid",
           "nombre",
           "apellidos",
           "dni",
           "telefono",
           "email",
           "foto",
           "fechaNacimiento",
           "fechaRegistro",
           "fechaAlta",
           "fechaBaja",
           "estado",
           "serviciosContratados",
           "fechaInicioActual",
           "fechaFinActual"
         ])
        && usuarioActual().negocioId is string
        && request.resource.data.negocioId is string
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.idCliente is int
        && request.resource.data.dni is string
        && request.resource.data.serviciosContratados is list
        && existsAfter(
             /databases/$(database)/documents/indices_clientes/$(request.resource.data.negocioId + "_" + request.resource.data.dni)
           )
        && getAfter(
             /databases/$(database)/documents/indices_clientes/$(request.resource.data.negocioId + "_" + request.resource.data.dni)
           ).data.clienteId == request.resource.data.idCliente;

      // VIA 2: el CLIENTE crea su propia ficha con el codigo maestro + DNI.
      // La operacion debe formar parte de la misma Transaction que crea el
      // indice y actualiza usuarios/{uid} (validado por creacionDirectaValida).
      allow create: if esCliente()
        && request.resource.data.keys().hasOnly([
           "idCliente",
           "negocioId",
           "firebaseUid",
           "nombre",
           "apellidos",
           "dni",
           "telefono",
           "email",
           "foto",
           "fechaNacimiento",
           "fechaRegistro",
           "fechaAlta",
           "fechaBaja",
           "estado",
           "serviciosContratados",
           "fechaInicioActual",
           "fechaFinActual"
         ])
        && request.resource.data.negocioId is string
        && request.resource.data.idCliente is int
        && string(request.resource.data.idCliente) == clienteId
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.dni is string
        && request.resource.data.serviciosContratados is list
        && creacionDirectaValida(
             request.resource.data.idCliente,
             request.resource.data.negocioId
           )
        && existsAfter(
             /databases/$(database)/documents/indices_clientes/$(request.resource.data.negocioId + "_" + request.resource.data.dni)
           )
        && getAfter(
             /databases/$(database)/documents/indices_clientes/$(request.resource.data.negocioId + "_" + request.resource.data.dni)
           ).data.clienteId == request.resource.data.idCliente;

      // VIA 1: el CLIENTE completa la vinculacion escribiendo su UID en una
      // ficha libre dentro del Batch que actualiza usuarios/{uid}.
      allow update: if esCliente()
        && request.resource.data.firebaseUid == request.auth.uid
        && resource.data.firebaseUid == null
        && resource.data.negocioId is string
        && request.resource.data.negocioId == resource.data.negocioId
        && resource.data.idCliente is int
        && string(resource.data.idCliente) == clienteId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["firebaseUid", "negocioId"])
        && vinculacionDniValida(
             resource.data.idCliente,
             request.auth.uid,
             request.resource.data.negocioId
           );

      // El CLIENTE vinculado puede editar sus datos personales, pero no el
      // DNI (identifica la ficha), ni campos administrativos ni el perfil.
      allow update: if esCliente()
        && string(usuarioActual().clienteId) == clienteId
        && resource.data.firebaseUid == request.auth.uid
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.idCliente == resource.data.idCliente
        && request.resource.data.dni == resource.data.dni
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.fechaAlta == resource.data.fechaAlta
        && request.resource.data.fechaBaja == resource.data.fechaBaja
        && request.resource.data.fechaInicioActual == resource.data.fechaInicioActual
        && request.resource.data.fechaFinActual == resource.data.fechaFinActual
        && request.resource.data.serviciosContratados == resource.data.serviciosContratados
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "nombre",
              "apellidos",
              "telefono",
              "email",
              "foto",
              "fechaNacimiento"
            ]);

      // El ADMIN edita la ficha. Si cambia el DNI debe mantener el indice
      // atomico: el nuevo indice nace y el viejo se borra en el mismo Batch.
      // Ademas puede actualizar el RESUMEN ECONOMICO del cliente (moroso, deuda,
      // fechaEntradaMorosidad, exentoMorosidad y fechas del periodo), claves que
      // el CLIENTE nunca puede escribir.
      allow update: if esAdmin()
        && usuarioActual().negocioId is string
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.negocioId is string
        && request.resource.data.negocioId == resource.data.negocioId
        && resource.data.idCliente is int
        && request.resource.data.idCliente == resource.data.idCliente
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "nombre",
              "apellidos",
              "dni",
              "telefono",
              "email",
              "foto",
              "fechaNacimiento",
              "serviciosContratados",
              "estado",
              "fechaAlta",
              "fechaBaja",
              "fechaInicioActual",
              "fechaFinActual",
              "moroso",
              "deuda",
              "fechaEntradaMorosidad",
              "exentoMorosidad"
            ])
        && (request.resource.data.dni == resource.data.dni
            || (existsAfter(
                  /databases/$(database)/documents/indices_clientes/$(resource.data.negocioId + "_" + request.resource.data.dni)
                )
                && !existsAfter(
                     /databases/$(database)/documents/indices_clientes/$(resource.data.negocioId + "_" + resource.data.dni)
                   )
                && getAfter(
                     /databases/$(database)/documents/indices_clientes/$(resource.data.negocioId + "_" + request.resource.data.dni)
                   ).data.clienteId == resource.data.idCliente));

      allow delete: if false;
    }


    // =========================================================
    // AGENDA DERIVADA DE UN CLIENTE (clientes/{id}/agenda/{fecha})
    // =========================================================
    // La agenda es un índice DERIVADO del día (nunca fuente de verdad): un
    // documento por (clienteId, día) con la estructura
    //   { negocioId, fecha, sesiones: { [sesionId]: idServicio } }.
    // La mantienen de forma atómica las Cloud Functions de reservas y las
    // cascadas del ADMIN (borrado de sesiones/servicios y bajas). El CLIENTE
    // solo puede LEER su propia agenda; nunca crearla, modificarla ni borrarla.
    // Ningún usuario accede a la agenda de clientes de otro negocio.

    match /clientes/{clienteId}/agenda/{fecha} {
      function clienteDelNegocio(negocioId) {
        let ref = /databases/$(database)/documents/clientes/$(clienteId);
        return exists(ref)
          && get(ref).data.negocioId == negocioId;
      }

      function agendaDelPropioNegocio() {
        return resource.data.negocioId == usuarioActual().negocioId;
      }

      function agendaPropiaDelCliente() {
        return esCliente()
          && string(usuarioActual().clienteId) == clienteId
          && agendaDelPropioNegocio();
      }

      // El ADMIN lee/liste la agenda de clientes de SU negocio. El get de un
      // documento inexistente (resource == null) se permite para que las
      // cascadas puedan comprobar si existe agenda que limpiar.
      allow get: if esAdmin()
        && clienteDelNegocio(usuarioActual().negocioId)
        && (resource == null || agendaDelPropioNegocio());

      allow list: if esAdmin()
        && clienteDelNegocio(usuarioActual().negocioId)
        && agendaDelPropioNegocio();

      // El CLIENTE solo lee su PROPIA agenda por día (get de clientes/{id}/agenda/{fecha}).
      // No necesita listar (su app lee los asistentes en cada sesión, no la agenda)
      // y nunca puede crear, modificar ni borrar su agenda.
      allow get: if agendaPropiaDelCliente();

      // Escritura: SOLO el ADMIN del negocio del cliente. Campos cerrados:
      // negocioId (del propio negocio), fecha y sesiones (map).
      allow create, update: if esAdmin()
        && clienteDelNegocio(usuarioActual().negocioId)
        && request.resource.data.keys().hasOnly(["negocioId", "fecha", "sesiones"])
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.fecha is int
        && request.resource.data.sesiones is map;

      allow delete: if esAdmin()
        && clienteDelNegocio(usuarioActual().negocioId)
        && agendaDelPropioNegocio();
    }


    // =========================================================
    // CLIENTES PRIVADOS (datos exclusivos del ADMIN)
    // =========================================================

    // observaciones (y cualquier dato interno) NO pertenece a clientes/{id};
    // vive en este documento accesible solo por el ADMIN del negocio, de modo
    // que un CLIENTE nunca pueda leerlo ni modificarlo.
    match /clientes_privados/{idCliente} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(["negocioId", "observaciones"])
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["observaciones"]);

      allow delete: if false;
    }


    // =========================================================
    // PERFILES PENDIENTES (CLIENTE registrado sin negocio)
    // =========================================================

    // Datos temporales de un CLIENTE que aun no pertenece a un negocio.
    // Admite DOS modos:
    //   - VIA 1 (declaracion de vinculacion): solo { dni, negocioId } escritos
    //     al introducir codigo maestro + DNI, para poder consultar el indice.
    //   - VIA 2 (perfil completo): nombre, apellidos, dni, telefono, email,
    //     foto, fechaNacimiento, cuando el cliente pulsa "No tengo codigo".
    // Solo su propio uid puede leerlo, crearlo, editarlo o borrarlo.
    // Se elimina al completar (o al rechazar) la vinculacion.
    match /perfiles_pendientes/{uid} {
      allow get: if autenticado()
        && request.auth.uid == uid;

      allow list: if false;

      allow create: if esCliente()
        && request.auth.uid == uid
        && request.resource.data.dni is string
        && request.resource.data.keys().hasOnly([
           "nombre",
           "apellidos",
           "dni",
           "telefono",
           "email",
           "foto",
           "fechaNacimiento",
           "negocioId"
         ]);

      allow update: if esCliente()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "nombre",
              "apellidos",
              "dni",
              "telefono",
              "email",
              "foto",
              "fechaNacimiento",
              "negocioId"
            ]);

      allow delete: if esCliente()
        && request.auth.uid == uid;
    }


    // =========================================================
    // INDICES DE CLIENTES (unicidad negocio+DNI)
    // =========================================================

    // Localiza la ficha por negocio+DNI y garantiza que solo exista una
    // ficha por combinacion. El documentId es {negocioId}_{dni}.
    match /indices_clientes/{indiceId} {
      // Un CLIENTE solo puede leer la combinacion negocio+DNI que declaro en
      // su perfil pendiente (VÍA 1: { dni, negocioId } / VÍA 2: dni). No puede
      // enumerar indices de otros ni leer otros negocios: se exige que el
      // negocioId y el DNI del indice coincidan con los declarados por el uid.
      // Un ADMIN puede leer los indices de su negocio (para mantenerlos).
      allow get: if autenticado()
        && (esAdmin()
              && resource.data.negocioId == usuarioActual().negocioId
            || resource == null
            || (exists(
                  /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
                )
                && get(
                     /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
                   ).data.dni == resource.data.dni
                && get(
                     /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
                   ).data.negocioId == resource.data.negocioId));

      allow list: if false;

      allow create: if indiceCreadoPorAdmin(indiceId)
        || indiceCreadoPorCliente(indiceId);

      allow update: if false;

      // El ADMIN solo borra un indice al cambiar el DNI de la ficha, en el
      // mismo Batch que crea el nuevo indice.
      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && getAfter(
             /databases/$(database)/documents/clientes/$(resource.data.clienteId)
           ).data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // SERVICIOS
    // =========================================================

    // Un servicio pertenece a un único negocio (negocioId = UID del ADMIN).
    // Solo el ADMIN de ese negocio puede leer, crear, modificar y eliminar.
    // El CLIENTE no puede crear, modificar ni eliminar servicios.
    match /servicios/{servicioId} {
      // El ADMIN lee sus servicios. La rama resource == null permite que una
      // Transaction compruebe la existencia del documento antes de crearlo
      // (mismo mecanismo que clientes en VÍA 2); no revela datos de otros.
      allow get: if esAdmin()
        && (resource == null
            || resource.data.negocioId == usuarioActual().negocioId);

      // Un CLIENTE vinculado puede leer un servicio ACTIVO de su negocio.
      // Necesario para que la Transaction de reserva pueda comprobar el servicio.
      allow get: if esCliente()
        && usuarioActual().clienteId is int
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.activo == true;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly([
             "idServicio",
             "negocioId",
             "nombre",
             "descripcion",
             "activo",
             "precio",
             "permiteCombinarDia"
           ])
        && request.resource.data.idServicio is int
        && string(request.resource.data.idServicio) == servicioId
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.nombre is string
        && request.resource.data.descripcion is string
        && request.resource.data.activo is bool
        && request.resource.data.precio is number
        && (!("permiteCombinarDia" in request.resource.data.keys())
            || request.resource.data.permiteCombinarDia is bool);

      // El ADMIN modifica nombre, descripcion, precio, activo y
      // permiteCombinarDia de SUS servicios. No puede mover el servicio a otro
      // negocio ni cambiar su id.
      // `precio` solo se exige numérico si el update lo toca (los documentos
      // creados antes de la Fase 2 pueden no tener todavía el campo).
      // `permiteCombinarDia` es opcional: si falta se interpreta como true en la
      // capa de negocio (plan_reservas), sin que Rules exijan el campo.
      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.idServicio == resource.data.idServicio
        && request.resource.data.nombre is string
        && request.resource.data.descripcion is string
        && request.resource.data.activo is bool
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["precio"])
            || request.resource.data.precio is number)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["permiteCombinarDia"])
            || request.resource.data.permiteCombinarDia is bool)
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["nombre", "descripcion", "precio", "activo", "permiteCombinarDia"]);

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // MOVIMIENTOS
    // =========================================================

    match /movimientos/{movimientoId} {
      allow get: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // CLASES
    // =========================================================

    match /clases/{claseId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get, list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // SESIONES
    // =========================================================

    // Una sesión pertenece directamente a un servicio (idServicio) y al
    // negocio del ADMIN. Modelo: Servicio -> Sesion (sin entidad Clase).
    match /sesiones/{sesionId} {
      // El ADMIN lee sus sesiones. La rama resource == null permite que una
      // Transaction compruebe la existencia del documento antes de crearlo.
      allow get: if esAdmin()
        && (resource == null
            || resource.data.negocioId == usuarioActual().negocioId);

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      // CLIENTE vinculado: solo sesiones cuyo servicio esté contratado Y activo
      // y cuyo negocio sea el suyo. No puede crear/modificar/eliminar. Un
      // cliente en BAJA no puede acceder a sesiones.
      allow get: if esCliente()
        && usuarioActual().clienteId is int
        && resource.data.negocioId == usuarioActual().negocioId
        && servicioContratadoPorCliente(resource.data.idServicio)
        && get(
             /databases/$(database)/documents/servicios/$(resource.data.idServicio)
           ).data.activo == true
        && clientePuedeAcceder(usuarioActual().clienteId);

      allow list: if esCliente()
        && usuarioActual().clienteId is int
        && resource.data.negocioId == usuarioActual().negocioId
        && servicioContratadoPorCliente(resource.data.idServicio)
        && get(
             /databases/$(database)/documents/servicios/$(resource.data.idServicio)
           ).data.activo == true
        && clientePuedeAcceder(usuarioActual().clienteId);

      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly([
             "idSesion",
             "negocioId",
             "idServicio",
             "fecha",
             "hora",
             "duracionMinutos",
             "capacidad",
             "plazasDisponibles",
             "horaDesdeReserva"
           ])
        && request.resource.data.idSesion is int
        && string(request.resource.data.idSesion) == sesionId
        && request.resource.data.negocioId is string
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.idServicio is int
        && request.resource.data.fecha is int
        && request.resource.data.hora is string
        && request.resource.data.duracionMinutos is int
        && request.resource.data.capacidad is int
        && request.resource.data.plazasDisponibles is int
        && (!("horaDesdeReserva" in request.resource.data.keys())
            || request.resource.data.horaDesdeReserva is string
            || request.resource.data.horaDesdeReserva == null)
        && servicioValidoParaSesion(
             request.resource.data.idServicio,
             request.resource.data.negocioId
           );

      // El ADMIN modifica los datos de la sesión sin cambiar ni el id ni el
      // negocio ni el servicio. El servicio debe seguir existiendo, siendo del
      // negocio y estando activo. También mantiene el mapa de ASISTENTES
      // (asistentes: { [clienteId]: nombre }) de las reservas CONFIRMADAS: las
      // cascadas de baja/eliminación retiran a un cliente con FieldValue.delete
      // (o reescriben el mapa) sin poder tocar otras claves de la sesión.
      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.idSesion == resource.data.idSesion
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.idServicio == resource.data.idServicio
        && request.resource.data.fecha is int
        && request.resource.data.hora is string
        && request.resource.data.duracionMinutos is int
        && request.resource.data.capacidad is int
        && request.resource.data.plazasDisponibles is int
        && (!("horaDesdeReserva" in request.resource.data.keys())
            || request.resource.data.horaDesdeReserva is string
            || request.resource.data.horaDesdeReserva == null)
        && (!("asistentes" in request.resource.data.keys())
            || request.resource.data.asistentes is map)
        && servicioValidoParaSesion(
             request.resource.data.idServicio,
             request.resource.data.negocioId
           )
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "fecha",
              "hora",
              "duracionMinutos",
              "capacidad",
              "plazasDisponibles",
              "horaDesdeReserva",
              "asistentes"
            ]);

      // CLIENTE: SOLO lectura de sesiones (get/list). FASE 4: el CLIENTE ya NO
      // puede modificar plazasDisponibles ni asistentes de la sesión; esas
      // escrituras las realizan las Cloud Functions callable (Admin SDK) o el
      // ADMIN en sus cascadas. Ninguna rama de update permite al CLIENTE tocar
      // una sesión.

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // RESERVAS
    // =========================================================

    // Una reserva identifica al cliente y la sesión: reservas/{clienteId}_{sesionId}.
    // La creación y la cancelación son ATÓMICAS (Transaction): la reserva y el
    // ajuste de plazasDisponibles van siempre juntos.
    match /reservas/{reservaId} {
      allow get: if esAdmin()
        && (resource == null
            || resource.data.negocioId == usuarioActual().negocioId);

      // El CLIENTE lee su propia reserva (o un documento inexistente para que la
      // Transaction compruebe que no hay duplicado). No revela reservas ajenas.
      allow get: if esCliente()
        && (resource == null
            || (resource.data.negocioId == usuarioActual().negocioId
                && resource.data.clienteId == usuarioActual().clienteId));

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.clienteId == usuarioActual().clienteId;

      // FASE 4: el CLIENTE ya NO crea ni elimina reservas directamente. La
      // reserva y su cancelación viven en las Cloud Functions callable
      // `reservar`/`cancelarReserva` (Admin SDK, no pasan por estas Rules).
      // El CLIENTE solo LEE sus propias reservas.
      allow create: if false;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if false;

      // El ADMIN elimina una reserva de su negocio dentro de una Transaction
      // que incrementa las plazas de la sesión, o en una CASCADA administrativa
      // que elimina la propia sesión en la misma operación (cascadaEliminaSesion).
      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && (reservaEliminadaValida(resource.data.sesionId, resource.data.negocioId)
            || cascadaEliminaSesion(resource.data.sesionId));

      allow delete: if false;
    }


    // =========================================================
    // SOLICITUDES
    // =========================================================
    // Flujo de solicitudes de baja (y futuras altas). El CLIENTE crea su
    // propia solicitud PENDIENTE (tipo BAJA/ALTA) y solo puede consultar las
    // suyas; el ADMIN de su negocio la acepta o rechaza y solo la modifica en
    // el sentido permitido (resolución), nunca de forma arbitraria.

    match /solicitudes/{solicitudId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get, list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.idCliente == usuarioActual().clienteId;

      // El CLIENTE solo crea para sí mismo, siempre PENDIENTE, con los campos
      // exactos del contrato, y solo si su ficha le permite solicitar la baja
      // (no BAJA ni ARCHIVADO).
      allow create: if esCliente()
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.idCliente == usuarioActual().clienteId
        && request.resource.data.estado == "PENDIENTE"
        && request.resource.data.tipo in ["ALTA", "BAJA"]
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             "idSolicitud",
             "negocioId",
             "idCliente",
             "firebaseUid",
             "fechaSolicitud",
             "estado",
             "tipo",
             "motivo"
           ])
        && request.resource.data.idSolicitud is string
        && request.resource.data.fechaSolicitud is timestamp
        && (!("motivo" in request.resource.data.keys())
            || request.resource.data.motivo is string)
        && esClientePuedeSolicitarBaja(
             request.resource.data.idCliente,
             request.resource.data.negocioId
           );

      // El ADMIN resuelve la solicitud: solo desde PENDIENTE y únicamente los
      // campos de resolución. Una solicitud ya ACEPTADA/RECHAZADA no se puede
      // volver a modificar.
      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.negocioId is string
        && request.resource.data.negocioId == resource.data.negocioId
        && resource.data.estado == "PENDIENTE"
        && request.resource.data.estado in ["ACEPTADA", "RECHAZADA"]
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["estado", "fechaResolucion", "resueltaPor", "motivo"])
        && (!("fechaResolucion" in request.resource.data.keys())
            || request.resource.data.fechaResolucion is timestamp)
        && (!("resueltaPor" in request.resource.data.keys())
            || request.resource.data.resueltaPor is string);

      allow update: if false;

      // El ADMIN elimina del historial SOLO solicitudes ya resueltas
      // (ACEPTADA/RECHAZADA). Una solicitud PENDIENTE no se puede borrar: sigue
      // requiriendo decisión. El borrado no altera el estado del cliente.
      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.estado != "PENDIENTE";

      allow delete: if false;
    }


    // =========================================================
    // NOTIFICACIONES (enviadas por el ADMIN)
    // =========================================================

    // Registro GLOBAL de una notificación enviada por el ADMIN de un negocio
    // (vista "notificaciones enviadas"). El CLIENTE nunca accede a esta
    // colección; su buzón vive en notificaciones_por_destinatario.
    match /notificaciones/{notificacionId} {
      allow get: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && usuarioActual().negocioId is string
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.keys().hasOnly([
             "negocioId",
             "titulo",
             "mensaje",
             "tipo",
             "origen",
             "modoDestino",
             "idsClientes",
             "clienteId",
             "grupo",
             "fechaCreacion",
             "fechaEnvio",
             "programada",
             "fechaProgramada",
             "estado"
           ])
        && request.resource.data.titulo is string
        && request.resource.data.mensaje is string
        && request.resource.data.tipo in ["MANUAL", "MOROSIDAD", "BAJA_CONFIRMADA", "PROGRAMADA", "SOLICITUD_BAJA", "CAMBIO_HORARIO"]
        && request.resource.data.origen in ["MANUAL", "AUTOMATICA", "PRECONFIGURADA"]
        && request.resource.data.modoDestino in ["INDIVIDUAL", "GRUPO", "TODOS"]
        && request.resource.data.fechaCreacion is timestamp
        && request.resource.data.programada is bool
        && request.resource.data.estado in ["PENDIENTE", "ENVIADA", "PROGRAMADA", "CANCELADA", "ERROR"]
        && (!("idsClientes" in request.resource.data.keys())
            || request.resource.data.idsClientes is list)
        && (!("clienteId" in request.resource.data.keys())
            || request.resource.data.clienteId is int)
        && (!("grupo" in request.resource.data.keys())
            || request.resource.data.grupo is string)
        && (!("fechaEnvio" in request.resource.data.keys())
            || request.resource.data.fechaEnvio is timestamp)
        && (!("fechaProgramada" in request.resource.data.keys())
            || request.resource.data.fechaProgramada is timestamp);

      // El CLIENTE crea una ÚNICA notificación de aviso al ADMIN cuando acaba
      // de vincularse (tipo VINCULACION). Se limita a su propia ficha y negocio,
      // con campos controlados y documentId determinista; si el documento ya
      // existe (reintento) se comporta como update y queda denegado (no se
      // duplica). No abre escritura genérica de notificaciones al cliente.
      allow create: if esCliente()
        && usuarioActual().clienteId is int
        && usuarioActual().negocioId is string
        && request.resource.data.keys().hasOnly([
             "negocioId",
             "titulo",
             "mensaje",
             "tipo",
             "origen",
             "modoDestino",
             "clienteId",
             "fechaCreacion",
             "estado"
           ])
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.clienteId == usuarioActual().clienteId
        && string(request.resource.data.clienteId) == string(usuarioActual().clienteId)
        && request.resource.data.tipo == "VINCULACION"
        && request.resource.data.origen == "AUTOMATICA"
        && request.resource.data.modoDestino == "INDIVIDUAL"
        && request.resource.data.titulo is string
        && request.resource.data.mensaje is string
        && request.resource.data.estado == "PENDIENTE"
        && request.resource.data.fechaCreacion is timestamp
        && !exists(
             /databases/$(database)/documents/notificaciones/$(notificacionId)
           );

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["estado", "fechaEnvio", "idsClientes"]);

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // NOTIFICACIONES POR DESTINATARIO (buzon del CLIENTE)
    // =========================================================

    // Buzón individual: notificaciones_por_destinatario/{clienteId}_{notificacionId}.
    // El CLIENTE solo lee y marca como leídas las suyas; el ADMIN de su negocio
    // las consulta y crea (la creación también puede venir del backend Cloud
    // Functions, que con Admin SDK omite las Rules).
    match /notificaciones_por_destinatario/{destinatarioId} {
      allow get: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.clienteId == usuarioActual().clienteId;

      allow list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.clienteId == usuarioActual().clienteId;

      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.keys().hasOnly([
             "negocioId",
             "notificacionId",
             "clienteId",
             "firebaseUid",
             "titulo",
             "mensaje",
             "tipo",
             "origen",
             "fechaEnvio",
             "leida",
             "fechaLeida"
           ])
        && request.resource.data.notificacionId is string
        && request.resource.data.clienteId is int
        && request.resource.data.firebaseUid is string
        && request.resource.data.titulo is string
        && request.resource.data.mensaje is string
        && request.resource.data.tipo in ["MANUAL", "MOROSIDAD", "BAJA_CONFIRMADA", "PROGRAMADA", "CAMBIO_HORARIO"]
        && request.resource.data.origen in ["MANUAL", "AUTOMATICA", "PRECONFIGURADA"]
        && request.resource.data.fechaEnvio is timestamp
        && request.resource.data.leida is bool
        && string(request.resource.data.clienteId) + "_" + request.resource.data.notificacionId == destinatarioId
        && (!("fechaLeida" in request.resource.data.keys())
            || request.resource.data.fechaLeida is timestamp);

      // El CLIENTE solo puede marcar como leída su propia notificación.
      allow update: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.clienteId == usuarioActual().clienteId
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.leida == true
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["leida", "fechaLeida"])
        && (!("fechaLeida" in request.resource.data.keys())
            || request.resource.data.fechaLeida is timestamp);

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // CONFIGURACION DE NOTIFICACIONES AUTOMATICAS (por negocio)
    // =========================================================

    match /configuracion_notificaciones/{configId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.keys()
            .hasOnly(["negocioId", "morosidad", "bajaConfirmada", "cambioHorario"])
        && request.resource.data.morosidad.activa is bool
        && request.resource.data.morosidad.recordatorioHoras is int
        && request.resource.data.bajaConfirmada.activa is bool
        && (!("cambioHorario" in request.resource.data.keys())
            || request.resource.data.cambioHorario.activa is bool);

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["morosidad", "bajaConfirmada", "cambioHorario"])
        && request.resource.data.morosidad.activa is bool
        && request.resource.data.morosidad.recordatorioHoras is int
        && request.resource.data.bajaConfirmada.activa is bool
        && (!("cambioHorario" in request.resource.data.keys())
            || request.resource.data.cambioHorario.activa is bool);

      allow delete: if false;
    }


    // =========================================================
    // DISPOSITIVOS FCM DE UN CLIENTE (clientes/{id}/dispositivos/{token})
    // =========================================================

    match /clientes/{clienteId}/dispositivos/{token} {
      function tokenDelClienteAutenticado() {
        return esCliente()
          && get(
               /databases/$(database)/documents/clientes/$(clienteId)
             ).data.firebaseUid == request.auth.uid;
      }

      allow get, list: if esAdmin()
        && get(
             /databases/$(database)/documents/clientes/$(clienteId)
           ).data.negocioId == usuarioActual().negocioId;

      allow create: if tokenDelClienteAutenticado()
        && request.resource.data.token is string
        && request.resource.data.token == token
        && request.resource.data.plataforma is string
        && request.resource.data.keys().hasOnly(["token", "plataforma", "updatedAt"])
        && (!("updatedAt" in request.resource.data.keys())
            || request.resource.data.updatedAt is timestamp);

      allow update: if tokenDelClienteAutenticado()
        && request.resource.data.token is string
        && request.resource.data.token == token
        && request.resource.data.plataforma is string
        && request.resource.data.keys().hasOnly(["token", "plataforma", "updatedAt"])
        && (!("updatedAt" in request.resource.data.keys())
            || request.resource.data.updatedAt is timestamp);

      allow delete: if tokenDelClienteAutenticado();
    }


    // =========================================================
    // DENUNCIAS DE CONTENIDO UGC (denuncias/{denunciaId})
    // =========================================================

    // Una denuncia se registra para que el ADMIN del negocio la revise.
    // - La crea un usuario autenticado del MISMO negocio (ADMIN o CLIENTE
    //   vinculado) denunciando contenido/usuarios de su propio negocio.
    // - El ADMIN de ese negocio puede leer y marcar como REVISADA.
    // - El CLIENTE nunca lista denuncias; solo puede leer las propias.
    match /denuncias/{denunciaId} {
      function denuncianteDelMismoNegocio(negocioId) {
        return (esAdmin() && negocioId == usuarioActual().negocioId)
          || (esCliente()
              && usuarioActual().clienteId is int
              && usuarioActual().negocioId is string
              && negocioId == usuarioActual().negocioId);
      }

      // El usuario denunciado (si existe) debe pertenecer al negocio: el propio
      // ADMIN/negocio (uid == negocioId) o un CLIENTE activo del mismo negocio.
      // Nunca puede denunciarse a uno mismo.
      function usuarioDenunciadoValido(negocioId, uid) {
        let ref = /databases/$(database)/documents/usuarios/$(uid);
        return uid == negocioId
          || (uid != request.auth.uid
              && uid is string
              && exists(ref)
              && get(ref).data.rol == "CLIENTE"
              && get(ref).data.activo == true
              && get(ref).data.negocioId == negocioId);
      }

      function usuarioDenunciadoEnNegocio(negocioId) {
        return !("usuarioDenunciadoUid" in request.resource.data.keys())
          || usuarioDenunciadoValido(
               negocioId,
               request.resource.data.usuarioDenunciadoUid
             );
      }

      allow create: if autenticado()
        && denuncianteDelMismoNegocio(request.resource.data.negocioId)
        && request.resource.data.denuncianteUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             "negocioId",
             "denuncianteUid",
             "usuarioDenunciadoUid",
             "tipo",
             "referencia",
             "motivo",
             "descripcion",
             "fecha",
             "estado"
           ])
        && request.resource.data.negocioId is string
        && request.resource.data.tipo in ["FOTO_CLIENTE", "NOTIFICACION", "LOGO_NEGOCIO"]
        && request.resource.data.referencia is string
        && request.resource.data.motivo in [
             "INAPROPIADO", "ACOSO", "OFENSIVO", "SUPLANTACION", "OTRO"
           ]
        && request.resource.data.fecha is timestamp
        && request.resource.data.estado == "PENDIENTE"
        && (!("usuarioDenunciadoUid" in request.resource.data.keys())
            || request.resource.data.usuarioDenunciadoUid is string)
        && (!("descripcion" in request.resource.data.keys())
            || request.resource.data.descripcion is string)
        && usuarioDenunciadoEnNegocio(request.resource.data.negocioId);

      allow get: if (esAdmin()
          && resource.data.negocioId == usuarioActual().negocioId)
        || (esCliente() && resource.data.denuncianteUid == request.auth.uid);

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["estado"])
        && request.resource.data.estado in ["PENDIENTE", "REVISADA"];

      allow delete: if false;
    }

    // =========================================================
    // BLOQUEO POR DEFECTO
    // =========================================================

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
