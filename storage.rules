rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================
    // LOGO DEL NEGOCIO
    // Ruta definitiva: negocios/{negocioId}/logo.jpg
    //   - READ : cualquier usuario autenticado (ADMIN o CLIENTE).
    //   - WRITE: solamente el ADMIN propietario del negocio.
    //   Solo imágenes (image/*) y máx. 10 MB cuando hay recurso nuevo.
    // =========================================================

    match /negocios/{negocioId}/logo.jpg {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && esAdminDelNegocio(negocioId)
        && (request.resource == null || esImagenValida());
    }

    // =========================================================
    // FOTO DE PERFIL DEL CLIENTE
    // Ruta definitiva: clientes/{clienteId}/foto.jpg
    //   - READ  : ADMIN del negocio del cliente  |  CLIENTE propietario.
    //   - WRITE (subir/reemplazar/eliminar): ADMIN del negocio del cliente
    //            |  CLIENTE propietario. Requiere que clientes/{clienteId}
    //            exista (alta doc-first: la ficha se crea antes de subir).
    //   Solo imágenes (image/*) y máx. 10 MB cuando hay recurso nuevo.
    // =========================================================

    match /clientes/{clienteId}/foto.jpg {
      allow read: if request.auth != null
        && (esAdminDelCliente(clienteId) || esDuenioDeLaFoto(clienteId));

      allow write: if request.auth != null
        && (esAdminDelCliente(clienteId) || esDuenioDeLaFoto(clienteId))
        && (request.resource == null || esImagenValida());
    }

    // =========================================================
    // BLOQUEO POR DEFECTO: cualquier otra ruta queda bloqueada.
    // =========================================================

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}

// El ADMIN es propietario del negocio si su documento usuarios/{uid}
// tiene rol ADMIN y negocioId == negocioId.
function esAdminDelNegocio(negocioId) {
  let u = firestore.get(
    /databases/(default)/documents/usuarios/$(request.auth.uid)
  ).data;
  return u != null
    && u.rol == 'ADMIN'
    && u.negocioId == negocioId;
}

// El ADMIN propietario del negocio al que pertenece el cliente.
function esAdminDelCliente(clienteId) {
  let u = firestore.get(
    /databases/(default)/documents/usuarios/$(request.auth.uid)
  );
  let c = firestore.get(
    /databases/(default)/documents/clientes/$(clienteId)
  );
  return u != null
    && u.data.rol == 'ADMIN'
    && u.data.negocioId != null
    && c != null
    && c.data.negocioId == u.data.negocioId;
}

// El CLIENTE es propietario de la foto si clientes/{clienteId}.firebaseUid
// coincide con el usuario autenticado (misma relación de vinculación que el
// resto del proyecto; no hay ninguna relación nueva).
function esDuenioDeLaFoto(clienteId) {
  let c = firestore.get(
    /databases/(default)/documents/clientes/$(clienteId)
  );
  return c != null
    && c.data.firebaseUid == request.auth.uid;
}

// Imagen válida: tipo image/* y máximo 10 MB.
function esImagenValida() {
  return request.resource != null
    && request.resource.size <= 10 * 1024 * 1024
    && request.resource.contentType.matches('image/.*');
}
